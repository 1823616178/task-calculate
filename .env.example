# App 服务
HOST=0.0.0.0
PORT=48980

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=root123
DB_NAME=task_calculate

# JWT（生产环境务必修改）
JWT_SECRET=dev-secret-change-me

# MQTT Broker
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# docker compose 中 app 容器访问宿主机服务的地址（可选，默认均走 host.docker.internal）
# 要求宿主机 MySQL / EMQX 监听 0.0.0.0（或 Docker 网桥地址），且 MySQL 账号允许从 Docker 网段登录
# DOCKER_DB_HOST=host.docker.internal
# DOCKER_DB_PORT=3306
# DOCKER_MQTT_URL=mqtt://host.docker.internal:1883

# 看板公网地址（告警通知中的看板链接，可选）
# APP_URL=http://localhost:48980

# 邮件通知渠道的 SMTP 配置（使用 email 渠道时必填）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# 数据保留：全局默认保留天数（0 或不配置 = 永久保留；系统级可在详情页覆盖）
# RETENTION_DAYS=90
